# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo

set output 'asymm.pdf'

set ylabel 'A(t)'
set xlabel 't (ns)'

p[0:250][] 'counts_asym.txt' u 1:4 w l notitle 

set output 'asymm_2.pdf'

p[0:250][] 'counts_asym_binned.txt' u 1:4 w l notitle 

set output 'N_F_counts.pdf'

set ylabel 'Counts'

p[0:250] 'counts_asym.txt' u 1:3 w l title 'Det 1', \
'counts_asym.txt' u 1:2 w l title 'Det 2', \
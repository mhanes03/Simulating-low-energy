# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

cd 'tntuples' 

start = 0
end = 1000
step = 10

set term pdfcairo

set xlabel "x (mm)"
set ylabel "y (mm)" 

set logscale cb
set format cb "10^{%T}"
set cbrange [1e-3:5e6]

set cblabel 'Energy (eV)'

set palette rgb 33,13,10
set colorbox

files(n) = sprintf('T%d.txt', n)

do for [i=start:end:step] {set output sprintf('%d_with_energy.pdf', i) 
p[][] files(i) u 1:2:(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette title sprintf('t = %d ns', i)}
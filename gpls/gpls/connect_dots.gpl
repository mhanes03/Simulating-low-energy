# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo

# Set axis labels
set ylabel "Captured muons (%)"

set output 'colour_coded_connected.pdf'

set palette rgb 33,13,10
set colorbox
set cblabel 'Paschen factor'

set xlabel "Pressure (mbar)"

start = 1
step = 0.1 
end = 3

p 'Paschen1.0.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.1.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.2.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \

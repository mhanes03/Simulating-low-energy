'Paschen1.4.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.5.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.6.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.7.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.8.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen1.9.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.0.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.1.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.2.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.3.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.4.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.5.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.6.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.7.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.8.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen2.9.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \
'Paschen3.0.txt' u ($5*1013):($8/1E2):1 w l palette notitle, \




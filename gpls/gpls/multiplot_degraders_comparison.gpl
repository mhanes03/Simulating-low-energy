# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo
set key top right

# Set axis labels
set ylabel "Mean energy (eV)"
set xlabel "z (mm)"

# Set axis labels
set xlabel "Degrader thickness (mm)"
set ylabel 'Mean energy (MeV)'


set output 'multiplot.pdf'

set multiplot layout 1,2 columns


set ylabel 'N_{f}/N_{i}'

p[][] '4_meV_beam/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '4 MeV', \
           'middle_energy/1.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '2.5 MeV'


set ylabel 'E_{f}/E_{i}'

p[][] '4_meV_beam/values.txt' u 1:($3/4) w lp pt 7 ps 0.4 title '4 MeV', \
           'middle_energy/1.0/values.txt' u 1:($3/4) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u 1:($3/4) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u 1:($3/4) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u 1:($3/4) w lp pt 7 ps 0.4 title '2.5 MeV'

unset multiplot 



set output 'comparison_number.pdf'

set ylabel 'N_{f}/N_{i}'

p[][] '4_meV_beam/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '4 MeV', \
           'middle_energy/1.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '2.5 MeV'



set output 'comparison_energy.pdf'

set ylabel 'E_{f}/E_{i}'


p[][] '4_meV_beam/values.txt' u 1:($3/4) w lp pt 7 ps 0.4 title '4 MeV', \
           'middle_energy/1.0/values.txt' u 1:($3/1) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u 1:($3/1.5) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u 1:($3/2) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u 1:($3/2.5) w lp pt 7 ps 0.4 title '2.5 MeV'


set output 'multiplot_no_4.pdf'

set multiplot layout 1,2 columns

set xlabel "Degrader thickness (microns)"

set ylabel 'N_{f}/N_{i}'

p[][] 'middle_energy/1.0/values.txt' u ($1*1e3):($4/10000) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u ($1*1e3):($4/10000) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u ($1*1e3):($4/10000) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u ($1*1e3):($4/10000) w lp pt 7 ps 0.4 title '2.5 MeV'


set ylabel 'E_{f}/E_{i}'

p[][] 'middle_energy/1.0/values.txt' u ($1*1e3):($3/1) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u ($1*1e3):($3/1.5) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u ($1*1e3):($3/2) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u ($1*1e3):($3/2.5) w lp pt 7 ps 0.4 title '2.5 MeV'

unset multiplot 




set output 'comparison_energy_no_4.pdf'

set ylabel 'E_{f}/E_{i}'

set xlabel "Degrader thickness (mm)"

p[0:0.2][] 'middle_energy/1.0/values.txt' u ($1):($3/1) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u ($1):($3/1.5) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u ($1):($3/2) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u ($1):($3/2.5) w lp pt 7 ps 0.4 title '2.5 MeV'

set output 'comparison_number_no_4.pdf'

set xlabel "Degrader thickness (mm)"

set ylabel 'N_{f}/N_{i}'

set key bottom left

p[][] 'middle_energy/1.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1 MeV' , \
           'middle_energy/1.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1.5 MeV', \
           'middle_energy/2.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '2.0 MeV', \
           'middle_energy/2.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '2.5 MeV'


exit 
# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term gif animate delay 50 loop 0 
set key top right

set cblabel 'Energy (eV)'
set logscale cb
set format cb "10^{%T}"
set cbrange [1e2:5e6]

set logscale y 
set format y "10^{%T}"
set mytics 10

set output 'energy_v_time_log_coded.gif'

cd 'zntuples'

start = 10
end = 1010
step = 10

# Set axis labels
set ylabel "Energy (eV)"
set xlabel "Time (ns)"

# using autoscale
files(n) = sprintf('Z%d.txt', n)

# with scales defined 
do for [i=start:end:step] {p[0:1000][1e1:5e6] files(i) u 7:(((((($4)**2)+(($5)**2)+(($6 > 0. ? $6:NaN)**2))/(2*105.66))*1e6)) w p pt 1 ps 1 title sprintf('z = %d mm, pz > 0', i), \
files(i) u 7:(((((($4)**2)+(($5)**2)+(($6 < 0. ? $6:NaN)**2))/(2*105.66))*1e6)) w p pt 1 title sprintf('z = %d mm, pz < 0', i)}


exit 
# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo
set key top right


# Set axis labels
set xlabel "Degrader thickness (mm)"


set output 'comparison_number.pdf'

set key bottom left
set ylabel 'N_{f}/N_{i}'

cd 'below_1_mev'

p[][] '0.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '0.5 MeV', \
           '1.0/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1 MeV' , \
           '1.5/values.txt' u 1:($4/10000) w lp pt 7 ps 0.4 title '1.5 MeV'


set output 'comparison_energy.pdf'

set key bottom left
set ylabel 'E_{f}/E_{i}'

p[][] '0.5/values.txt' u 1:($3/0.5) w lp pt 7 ps 0.4 title '0.5 MeV', \
           '1.0/values.txt' u 1:($3/1) w lp pt 7 ps 0.4 title '1 MeV' , \
           '1.5/values.txt' u 1:($3/1.5) w lp pt 7 ps 0.4 title '1.5 MeV'


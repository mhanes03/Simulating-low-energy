# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set format x '%1.0f'

set term pdfcairo

set mxtics 1

# Set axis labels
set xlabel "z (mm)"
set ylabel "E_{f}/E_{i}"

set output 'avg_energy_v_z_all.pdf'

p[][] '50/zntuples/E_mean_no_muons_z.txt' u 1:($2/4) w l title 'P = 50 mbar', \
'75/zntuples/E_mean_no_muons_z.txt' u 1:($2/4) w l title 'P = 75 mbar', \
'100/zntuples/E_mean_no_muons_z.txt' u 1:($2/4) w l title 'P = 100 mbar', \

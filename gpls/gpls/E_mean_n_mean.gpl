set output 'avg_energy_v_z_log.pdf' 

set logscale y 
set format y "10^{%T}"
set mytics 10

# Set axis labels
set xlabel "z (mm)"
set ylabel "Average energy (eV)"

p[-10:1010][] '50/zntuples/E_mean_no_muons_z.txt' u 1:($2*1e6) w l notitle


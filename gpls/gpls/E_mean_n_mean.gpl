# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set format x '%1.0f'

set term pdfcairo

set mxtics 1

# Set axis labels
set xlabel "z (mm)"
set ylabel "Average energy (MeV)"

set output 'avg_energy_v_z.pdf'

p[][] 'E_mean_no_muons_z.txt' u 1:2 w l notitle

set xlabel "z (mm)"
set ylabel "Number of muons"

set output 'number_muons_versus_z.pdf'

p[][] 'E_mean_no_muons_z.txt' u 1:3 w l notitle

set output 'avg_energy_v_z_log.pdf' 

set logscale y 
set format y "10^{%T}"
set mytics 10

# Set axis labels
set xlabel "z (mm)"
set ylabel "Average energy (eV)"

p[-10:1010][] 'E_mean_no_muons_z.txt' u 1:($2*1e6) w l notitle
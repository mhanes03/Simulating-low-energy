# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

set logscale x 
set format x "10^{%T}"
set mxtics 10

set xlabel "Energy (eV)"

set ylabel "N_{f}/N_{i}"

set output 'number_of_muons.pdf'

p[][0:1.2] '0.001' u ($1*1e6):($4/10000) w l title '0.001 mm', \
'0.01' u ($1*1e6):($4/10000) w l title '0.01 mm', \
'0.1' u ($1*1e6):($4/10000) w l title '0.1 mm'


set logscale y 
set format y "10^{%T}"
set mytics 10

set ylabel "dE (eV)"
set output 'dE.pdf'

p[][] '0.001' u ($1*1e6):($2*1e6) w l title '0.001 mm', \
'0.01' u ($1*1e6):($2*1e6) w l title '0.01 mm', \
'0.1' u ($1*1e6):($2*1e6) w l title '0.1 mm'
# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term postscript eps colour 
set output 'surface_plot.eps'

set ztics 0, 2000

set xlabel "P'_{z} (MeV/c)"
set ylabel 'Pz (MeV/c)'
set zlabel 'Event ID' rotate by 90

set view 30
#set pm3d

splot[][] 'zntuples/pz_before_and_After_50.txt' u 2:4:3  notitle


set output 'surface_plot_2.eps'

set dgrid3d 
set grid 
set view 50
set style data lines
set contour base

splot[][] 'zntuples/pz_before_and_After_50.txt' u 2:4:3  notitle


set output 'surface_plot_3.eps'

#set dgrid3d 
#set grid 
#set view 50
#set style data lines
#set contour base

reset
set contour
unset surface
set cntrparam levels incr 1,1000,10000

set view map
set xrange [0:30]
set yrange [0:30]

set dgrid3d 100,100,4

set table "contour.txt"
splot 'zntuples/pz_before_and_After_50.txt' u 2:4:3 
unset table

unset contour
set surface
set table "dgrid.txt"
splot 'zntuples/pz_before_and_After_50.txt' u 2:4:3 
unset table

reset
set pm3d map
unset key

set palette

set autoscale fix
set grid

splot 'zntuples/pz_before_and_After_50.txt' u 2:4:3 w pm3d, 'contour.txt' w l lc rgb "black"




# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo

set xlabel 'Detector'
set ylabel 'Counts'

set output 'bar_chart_of_counts.pdf'

set style data histogram
set style histogram cluster gap 1
set style fill solid
set boxwidth 0.9
set xtics format ""
set grid ytics

p[][] 'counts_file.txt' u 2:xtic(1) title 'No lead', \
'counts_file.txt' u 3 title 'Start', \
'counts_file.txt' u 4 title 'End', \
'counts_file.txt' u 4 title 'Both', \



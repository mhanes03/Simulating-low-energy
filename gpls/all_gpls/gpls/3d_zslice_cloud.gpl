# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"
#load "~/gpls/newcolours.colour"

set term pdfcairo

set output 'graph.pdf'

start = 10 
end = 190
step = 10 

unset size


#set grid nopolar
set grid
set grid layerdefault   lt 0 linecolor 0 linewidth 0.500,  lt 0 linecolor 0 linewidth 0.500
set logscale z
set format z "10^{%T}"
set mztics 10

set xtics 200 1000 400
set xtics 400
set x2range [ 0 : 2000 ] noreverse nowriteback
set urange [ * : * ] noreverse nowriteback
set vrange [ * : * ] noreverse nowriteback
set ytics 1 10 1
set ytics 1 10 2

set palette rgb 33,13,10
set colorbox

set xlabel 'Time (ns)'
set xlabel  offset character -1, -1, 0 font "" textcolor lt -1 norotate

set ylabel 'z (cm)'

set zlabel 'Energy (eV)' rotate
set logscale cb
set format cb "10^{%T}"
set cbrange [1e-3:1e4]

#set cblabel 'Energy (eV)' rotate 

#set colorbox vertical origin screen 0.8, 0.2 size screen 0.05, 0.5 front  noinvert bdefault

# using autoscale
files(n) = sprintf('Z%d.txt', n)

#set zrange [*:*] noreverse nowriteback

# with scales defined 
do for [i=start:end:step] {
splot[0:2000][0:19][1e-3:1e4] files(i) u 7:($3*0.1):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette notitle}

set output 'attempt_one.pdf'

set logscale z
set format z "10^{%T}"
set mztics 10
set view 70, 45,1 ,1

splot[0:2000][0:10][1e-3:1e4] 'Z10.txt' u 7:($3*0.1):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette notitle, \
'Z20.txt' u 7:($3*0.1):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette notitle, \
'Z40.txt' u 7:($3*0.1):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette notitle, \
'Z60.txt' u 7:($3*0.1):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette notitle, \
'Z80.txt' u 7:($3*0.1):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)):(((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))*1e6)) w p palette notitle, \



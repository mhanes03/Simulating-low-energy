# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

cd 'zntuples' 

start = 10
end = 1000
step = 10

set term pdfcairo
set autoscale

# Set axis labels
set xlabel "Energy (keV)"
set ylabel "Events" 

# using autoscale
files(n) = sprintf('Z%d.txt', n)

set output 'comparison.pdf'

set style fill transparent solid 0.5

p[][0:160] 'Z10.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 10 mm', \
'Z250.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 250 mm', \
'Z500.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 500 mm', \
'Z750.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 750 mm', \
'Z1000.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 1000 mm'

set output 'comparison_3.pdf'

set style fill transparent solid 0.5

p[][0:160] 'Z10.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 10 mm', \
'Z250.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 250 mm', \
'Z500.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 500 mm', \
'Z750.txt' u (((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) < 50. && ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3) > 1.  ? ((((($4)**2+($5)**2+($6)**2)/(2*105.66)))*1e3):NaN) bins=25 w boxes title 'z = 750 mm', \
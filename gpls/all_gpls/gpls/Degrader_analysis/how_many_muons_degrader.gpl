# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set format x '%1.1f'

set term pngcairo
set key top right

#set cblabel 'Number of muons'

set cblabel font ",11"

#set ylabel font ",11"


set logscale cb
set format cb "10^{%T}"
set cbrange [1e0:1e4]
set cblabel '<E> (eV)'
set cblabel offset 1.25 font ',10'

# Set axis labels
set ylabel "Mean energy (eV)"
set xlabel "z (mm)"

# Set axis labels
set xlabel "Degrader thickness (mm)"
set ylabel 'Mean energy (MeV)'

set key samplen 2 spacing 1 font ",12"


set output 'mean_energy.png'

p[][] 'values.txt' u 1:3 w p notitle 

set output 'mean_energy_percent.png'

set ylabel 'E_{f}/E_{i}'

p[][] 'values.txt' u 1:($3/4) w lp notitle 


set output 'number_of_muons.png'

set ylabel 'N_{f}/N_{i}'

p[][0:1.1] 'values.txt' u 1:($4/10000) w p notitle 


set output 'number_of_muons_wl.png'

set ylabel 'N_{f}/N_{i}'

p[][] 'values.txt' u 1:($4/10000) w lp notitle 

  

exit 

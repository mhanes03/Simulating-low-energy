# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo
set autoscale

# Set axis labels
set xlabel "Energy (MeV)"
set ylabel "Events" 

set style fill transparent solid 0.5

set output 'energy_distr.pdf'

p[-0.5:2.5][] '0.975/TRANSMIT.txt' u ($4*1e-6)  bins=25 w boxes title '0.975 mm', \
'0.985/TRANSMIT.txt' u ($4*1e-6)  bins=25 w boxes title '0.985 mm', \
'1/TRANSMIT.txt' u ($4*1e-6)  bins=25 w boxes title '1.0 mm'

# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set format x '%1.0f'

set term pngcairo
set key top right


# Set axis labels
set xlabel "z (mm)"
set ylabel "N_{f}/N_{i}"

cd 'zntuples'

set output 'number_of_muons_zntuples_one_plot.png'

p[][0:1.25] 'E_mean_no_muons_z.txt' u 1:($3/1e6) w l title 'P = 50 mbar', \
'../../500/zntuples/E_mean_no_muons_z.txt' u 1:($3/1e6) w l title 'P = 500 mbar', \
'../../1000/zntuples/E_mean_no_muons_z.txt' u 1:($3/1e6) w l title 'P = 1 bar'


exit 

# Load styles
load "~/nature.journal"
load "~/bluegold-sl.colour"

set term pngcairo
set key top right

#set cblabel 'N'


set output 'number_of_muons.png'

set logscale y 
set mytics 10
set format y "10^{%T}"
set ytics mirror

# Set axis labels
set ylabel "Mean energy (eV)"
set xlabel "z (mm)"

set palette rgb 10,12,14
set palette rgb 33,13,10
set colorbox
set logscale cb
set format cb "10^{%T}"
set cbrange [1e0:1e4]

# with scales defined 
p[0:500][] 'E_mean_no_muons_z.txt' u 1:(($2*1e6)):3 w p palette notitle

exit 

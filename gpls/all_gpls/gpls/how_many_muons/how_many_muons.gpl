# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set format x '%1.0f'

set term pngcairo
set key top right

#set cblabel 'Number of muons'


set output 'number_of_muons_zntuples_palette.png'

set multiplot layout 2,2 columns
set key samplen 2 spacing .5 font ",10"

set cblabel font ",11"

#set ylabel font ",11"

set xtics (0,300,600,900)

set logscale cb
set format cb "10^{%T}"
set cbrange [1e0:1e4]
set cblabel '<E> (eV)'
set cblabel offset 1.25 font ',10'

# Set axis labels
set ylabel "Mean energy (eV)"
set xlabel "z (mm)"

set palette rgb 10,12,14
set palette rgb 33,13,10
set colorbox

# Set axis labels
set xlabel "z (mm)"
set ylabel "N/N_{total}"

p[-10:1010][0:2] '20/E_mean_no_muons_z.txt' u 1:($3/10000):($2*1e6) w l palette title 'E = 20 kV/m'

p[-10:1010][0:2] '30/E_mean_no_muons_z.txt' u 1:($3/10000):($2*1e6) w l palette title 'E = 30 kV/m'

p[-10:1010][0:2] '40/E_mean_no_muons_z.txt' u 1:($3/10000):($2*1e6) w l palette title 'E = 40 kV/m'

p[-10:1010][0:2] '50/E_mean_no_muons_z.txt' u 1:($3/10000):($2*1e6) w l palette title 'E = 50 kV/m'

unset multiplot

set key samplen 2 spacing 1 font ",12"

set xtics (0,200,400,600,800,1000)

set output 'number_of_muons_zntuples_one_plot.png'

p[-10:1010][0:2] '20/E_mean_no_muons_z.txt' u 1:($3/10000) w l title 'E = 20 kV/m', \
  '30/E_mean_no_muons_z.txt' u 1:($3/10000) w l title 'E = 30 kV/m', \
  '40/E_mean_no_muons_z.txt'  u 1:($3/10000) w l title 'E = 40 kV/m' ,\
  '50/E_mean_no_muons_z.txt' u 1:($3/10000) w l title 'E = 50 kV/m'

exit 
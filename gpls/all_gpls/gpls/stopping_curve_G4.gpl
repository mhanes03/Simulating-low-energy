# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo

# Set axis labels
set xlabel "Energy (eV)"
set ylabel "Stopping power (MeV cm^2/g)"

set logscale y 
set format y "10^{%T}"
set mytics 10

set logscale x 
set format x "10^{%T}"
set mxtics 10

set output 'Stopping_curve.pdf'

p '0.001' u ($1*1e6):3 w l title '0.001 mm', \
'0.01' u ($1*1e6):3 w l title '0.01 mm', \
'0.1' u ($1*1e6):3 w l title '0.1 mm'

#set output 'Stopping_curve_diff_units.pdf'

#set ylabel "Stopping power (eV cm^2/10^{15} atoms)"


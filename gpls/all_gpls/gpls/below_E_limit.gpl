# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo 

set xlabel 'z (mm)'
set ylabel 'Below energy limit (%)'

set output 'below_E_lim.pdf'

set title 'Energy limit = 0.3 MeV'
p 'zntuples/less_than_0.3MeV.txt' u 1:($3/1e3) w l title 'g4bl', \
'../g4_with_trim_file/zntuples/less_than_0.3MeV.txt' u 1:($3/1e2) w l title 'Trim', \


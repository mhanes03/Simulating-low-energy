# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo 

set xlabel 'z (mm)'
set ylabel 'Captured (%)'

set output 'captured.pdf'


p[][0:1.8] 'zntuples/captured.txt' u 1:($3/1e3) w l title 'E-field', \


set output 'captured_comp.pdf'

p 'e-field/zntuples/captured.txt' u 1:($3/1e2) w l title 'E-field', \
'zntuples/captured.txt' u 1:($3/1e2) w l title 'No e-field', \

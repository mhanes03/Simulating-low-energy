# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

cd 'zntuples' 

set term pdfcairo
set autoscale

set style fill transparent solid 0.5

set xlabel "Energy (keV)"
set ylabel "Events" 


set output 'multiplot.pdf' 


set multiplot layout 2,2 columns

# plots the z stopping distance distribution
p[0:0.6][0:1100] 'Z100.txt' u (((($4)**2+($5)**2+($6)**2)/(2*105.66))*1e3) bins=25 w boxes title 'z = 100 mm'


p[0:0.6][0:500] 'Z300.txt' u (((($4)**2+($5)**2+($6)**2)/(2*105.66))*1e3) bins=25 w boxes title 'z = 300 mm'

p[0:0.6][0:1100] 'Z200.txt' u (((($4)**2+($5)**2+($6)**2)/(2*105.66))*1e3) bins=25 w boxes title 'z = 200 mm'


p[0:0.6][0:35] 'Z400.txt' u (((($4)**2+($5)**2+($6)**2)/(2*105.66))*1e3)  bins=25 w boxes title 'z = 400 mm'

unset multiplot 
# Load styles
load "~/nature.journal"
load "~/bluegold-sl.colour"

set term pdfcairo
set key top right

# Set axis labels
set ylabel "Kinetic energy (MeV)"
set xlabel "Time (ns)"

set output 'energy_v_time_log.pdf'

set palette rgb 33,13,10
set colorbox

set cblabel 'Energy (MeV)'
set logscale cb
set format cb "10^{%T}"

cd 'zntuples'
start = 10
end = 1010
step = 10

# Set axis labels
set ylabel "Energy (MeV)"
set xlabel "Time (ns)"

# using autoscale
files(n) = sprintf('Z%d.txt', n)

do for [i=start:end:step] {
p[][] files(i) u 7:((($4)**2+($5)**2+($6)**2)/(2*105.66)):(log10(((($4)**2+($5)**2+($6)**2)/(2*105.66)))) w p palette title sprintf('z = %d mm', i)
}

# Load styles
load "~/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term gif animate delay 75 loop 0 
set key top right

set output 'energy_dist_2.gif'

cd 'zntuples'

start = 200
end = 500
step = 10

# Set axis labels
set xlabel "Energy (keV)"
set ylabel "Counts"

# using autoscale
files(n) = sprintf('Z%d.txt', n)

set style fill solid 0.5 

# with scales defined 
do for [i=start:end:step] {p[0:1.5][0:1000] files(i) u ((((((($4)**2)+(($5)**2)+(($6)**2))/(2*105.66))))*1e3) bins=25 w boxes title sprintf('z = %d mm', i)}

exit 

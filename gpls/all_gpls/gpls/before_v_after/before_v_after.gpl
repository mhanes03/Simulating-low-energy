# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"



set term pngcairo
set key top right


set ylabel "Counts"

set xlabel "Energy (MeV)"

set ylabel "Counts"

set output 'before_v_after_degrader.png'



set style fill transparent solid 0.5

p[][0:1000] 'zntuples/Z760.txt' u ((($4**2)+($5**2)+($6**2))/(2*105.66)) bins=25 w boxes title 'z = 760 mm' ,\
'zntuples/Z770.txt' u ((($4**2)+($5**2)+($6**2))/(2*105.66))  bins=25 w boxes title 'z = 770 mm 


set xlabel "Energy (keV)"

set style fill transparent solid 0.5

set output '520_below_keV.png'


p[][] 'zntuples/less_1keV_520.txt' u (((($4**2)+($5**2)+($6**2))/(2*105.66))*1e3) bins=25 w boxes title 'z = 520 mm E <= 1 keV'



# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set term pdfcairo

# Set axis labels
set ylabel "Captured muons (%)"

set output 'In_eqm_bounds.pdf'

set palette rgb 33,13,10
set colorbox
set cblabel 'Paschen factor'

set xlabel "Pressure (mbar)"

p[] 'optimisation_trail.txt' u ($5*1013):($9/1E4):1 w p palette notitle

set output 'In_eqm_bound_volt.pdf'

set palette rgb 33,13,10
set colorbox
set cblabel 'Density factor'

set xlabel "Volt (kV)"

p[] 'optimisation_trail.txt' u ($3*4E-2*1E3):($9/1E4):2 w p palette notitle

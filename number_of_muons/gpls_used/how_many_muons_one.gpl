# Load styles
load "~/gpls/nature.journal"
load "~/gpls/bluegold-sl.colour"

set format x '%1.0f'

set term pngcairo
set key top right


# Set axis labels
set xlabel "z (mm)"
set ylabel "N/N_{total}"



set output 'number_of_muons_zntuples_one_plot.png'

p[-10:1010][0:2] 'E_mean_no_muons_z.txt' u 1:($3/10000) w l title 'E = 20 kV/m'


exit 